# For production, set exact trusted frontend origin(s), never '*'.
ANCHOR_ALLOWED_ORIGINS=https://anchor.example.com
ANCHOR_RELAY_DB=/data/relay.sqlite3
ANCHOR_MAX_CIPHERTEXT_BYTES=1048576
ANCHOR_MAX_VAULT_BYTES=52428800

# Optional: configure a strong operator secret to enable destructive vault purge.
ANCHOR_ADMIN_TOKEN=replace-with-a-long-random-secret
